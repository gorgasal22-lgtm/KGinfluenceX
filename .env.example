# ============================================================================
# KGinfluenceX — environment variables (placeholders only)
# Copy this file to `.env.local` and fill values. NEVER commit real keys.
# ============================================================================

# ---- Supabase (used by lib/supabase.ts in Next.js app) ----
# Get from Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLISHABLE-KEY

# ---- Supabase (used by artifacts/kginfluencex Vite app) ----
# Same values as above — Vite reads them via import.meta.env.VITE_*
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLISHABLE-KEY

# ---- API server (artifacts/api-server) ----
# Postgres connection string for Drizzle ORM
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# ---- Edge function / AI (optional, used by /api/generate if present) ----
ANTHROPIC_API_KEY=your-anthropic-key-here

# ============================================================================
# SECURITY NOTES
# ---------------------------------------------------------------------------
# 1. COMMANDO rule (Georgian: "არასოდეს დაკომიტო რეალური .env"):
#    .gitignore already covers .env, .env.local, .env.*.local.
#    Never commit a real .env file by mistake (git status before push).
# 2. The previously leaked publishable key has been removed from
#    lib/supabase.ts. Even publishable keys must be rotated if they were
#    committed to a public repo — see ROTATION STEPS in replit.md / docs.
# 3. NEVER put service_role JWT here — service_role must live only on
#    backend / server side, never NEXT_PUBLIC_* / VITE_*.
# ============================================================================
